{
  "name": "signaldesk",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed": "tsx --conditions=react-server --env-file=.env.local scripts/seed.ts",
    "ingest": "tsx --conditions=react-server --env-file=.env.local scripts/run-ingest.ts",
    "eval": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/eval-stance.ts",
    "gen-secret": "tsx scripts/gen-secret.ts",
    "check": "npm run typecheck && npm run lint && npm run test",
    "migrate": "tsx --env-file=.env.local scripts/migrate.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.1",
    "groq-sdk": "1.6.0",
    "next": "15.5.26",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "rss-parser": "3.13.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.4",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.26",
    "pg": "8.23.0",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
