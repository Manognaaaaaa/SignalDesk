# Copy to .env.local and fill in. NEVER commit real values.
# Only the two NEXT_PUBLIC_ values are exposed to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_PRICE_IN_PER_M=0.59
GROQ_PRICE_OUT_PER_M=0.79
CONVERSION_WEBHOOK_SECRET=
CRON_SECRET=
IP_HASH_SALT=
# Comma-separated hostnames, e.g. example.com,partner.example.org
ALLOWED_DESTINATION_DOMAINS=
APP_BASE_URL=
# Comma-separated hostnames the load test may target, e.g. localhost,your-app.vercel.app
LOADTEST_ALLOWED_HOSTS=
MAX_LLM_CALLS_PER_DAY=300
MAX_EXPLANATIONS_PER_RUN=10
PROMPT_VERSION=v1
REPLAY_MAX_ROWS=200000
# Local seeding only - never set these on Vercel
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_AFFILIATE_PASSWORD=
# Optional: public repository URL, linked from /evaluation
REPO_URL=
