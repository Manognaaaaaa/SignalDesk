# Copy to .env.local and fill in. NEVER commit real values.
# Only the two NEXT_PUBLIC_ values are exposed to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: without it, ingestion, story grouping and asset matching still run; stances/briefs are skipped or templated.
GROQ_API_KEY=
# llama-3.3-70b-versatile is no longer served by Groq; gpt-oss-120b is its current large general model (see README)
GROQ_MODEL=openai/gpt-oss-120b
GROQ_PRICE_IN_PER_M=0.15
GROQ_PRICE_OUT_PER_M=0.75
# npm run gen-secret
CRON_SECRET=
# e.g. http://localhost:3000 locally, https://your-app.vercel.app in production
APP_BASE_URL=
# Comma-separated emails allowed to trigger the ingest job from a logged-in session
ADMIN_EMAILS=
MAX_LLM_CALLS_PER_DAY=400
MAX_STANCE_CALLS_PER_RUN=60
PROMPT_VERSION=v1
